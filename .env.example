# Copy to .env and adjust. Never commit real values.
# Compose sets POSTGRES_HOST, POSTGRES_PORT, REDIS_URL, OTP_URL_* and
# VITE_API_PROXY_TARGET for containers itself; they are listed for running outside Docker.

# Django settings module (config.settings.dev | test | prod)
DJANGO_SETTINGS_MODULE=config.settings.dev
# Django secret key; use a long random value outside local development
DJANGO_SECRET_KEY=dev-insecure-change-me
# 1 enables debug mode, 0 disables it
DJANGO_DEBUG=1
# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL database name
POSTGRES_DB=lepszejakdojade
# PostgreSQL user
POSTGRES_USER=lepszejakdojade
# PostgreSQL password; use a strong value outside local development
POSTGRES_PASSWORD=change-me
# PostgreSQL host (compose service name "db" inside Docker)
POSTGRES_HOST=db
# PostgreSQL port
POSTGRES_PORT=5432

# Redis URL used by Celery and cache
REDIS_URL=redis://redis:6379/0

# Application version shown by the API
APP_VERSION=dev

# OpenTripPlanner base URL per city (compose service names inside Docker)
OTP_URL_KRAKOW=http://otp-krakow:8080
OTP_URL_WARSZAWA=http://otp-warszawa:8080
# Directory where prepare_otp_inputs writes per-city OTP base dirs (/otp/data in the container)
# OTP_DATA_DIR=/otp/data
# Directory with committed OTP configs (/otp in the container)
# OTP_CONFIG_DIR=/otp
# JVM heap when serving a prebuilt graph (measured: Krakow ~1 GB, Warsaw ~1.8 GB)
OTP_KRAKOW_SERVE_JAVA_OPTS=-Xmx2G
OTP_WARSZAWA_SERVE_JAVA_OPTS=-Xmx3G
# JVM heap when building a graph (measured peak: Krakow ~3.5 GB, Warsaw ~7.4 GB).
# Build one city at a time.
OTP_KRAKOW_BUILD_JAVA_OPTS=-Xmx4G
OTP_WARSZAWA_BUILD_JAVA_OPTS=-Xmx7G

# Google Gemini API key for the AI assistant (used later; leave empty for now)
GEMINI_API_KEY=

# Vite dev server proxy target for /api requests
VITE_API_PROXY_TARGET=http://backend:8000

# 1 enables file polling for Vite hot reload (needed on Windows/macOS bind mounts)
VITE_USE_POLLING=1

# true serves mock departures in the frontend; only works in the Vite dev server (not in a built app)
VITE_DEPARTURES_MOCK=false

# Dev only (Vite dev server): mock the tickets API. true = mock catalogue, empty = no tickets,
# fail = HTTP 500, offline = network error. Leave empty to use the real API.
VITE_TICKETS_MOCK=

# Host ports published by compose
# Host port for PostgreSQL. Set to e.g. 5433 when a local PostgreSQL already uses 5432.
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173
OTP_KRAKOW_PORT=8080
OTP_WARSZAWA_PORT=8081

# Optional: directory with city YAML configs (default: backend/cities/config, i.e. /app/cities/config in the container)
# CITY_CONFIG_DIR=/app/cities/config

# Seconds between GTFS-Realtime TripUpdates polls (Celery beat)
REALTIME_POLL_INTERVAL_SECONDS=30

# API key for the City of Warsaw open data API (api.um.warszawa.pl, live vehicle positions).
# Register at api.um.warszawa.pl; optional until Warsaw live data (#20) is implemented.
UM_WARSZAWA_API_KEY=

# Hour and minute (Europe/Warsaw) of the nightly static GTFS import (Celery beat)
GTFS_IMPORT_HOUR=3
GTFS_IMPORT_MINUTE=30
